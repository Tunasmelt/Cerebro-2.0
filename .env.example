# Supabase project: "Cerebro" (vuwrefjsvtinnsvgeftq, ap-southeast-1)
# Real values go in .env / .env.local (git-ignored), never here.
#
# apps/web reads apps/web/.env.local (Next.js's own convention).
# services/api reads services/api/.env, loaded explicitly via
# python-dotenv in app/main.py's load_dotenv() call (added so
# `uvicorn app.main:app` works locally without exporting vars by hand —
# Render itself sets real env vars directly, so this is a no-op there).
# Leave a var out of the file entirely rather than writing it with a
# blank value — an empty-but-present KEY= is NOT the same as unset to
# every consumer (e.g. langfuse-python treats a blank key as
# "configured" and attempts a real network call instead of the clean
# no-op core/tracing.py promises for a genuinely unset key).

# apps/web
NEXT_PUBLIC_SUPABASE_URL=https://vuwrefjsvtinnsvgeftq.supabase.co
# publishable key, not the legacy anon key — Supabase's current strongly
# recommended naming (Stage 1.6); both work, this is the one to add to
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server-only: apps/web's own API route handlers proxy to services/api
API_BASE_URL=https://cerebro-api-d47y.onrender.com

# services/api — uses the caller's own JWT for Storage/PostgREST calls
# (see Stage 1.1), not a service-role key, so RLS enforces ownership the
# same way it does for direct client access. anon key is not a secret
# (already public-safe, used client-side too) but still lives in env.
SUPABASE_URL=https://vuwrefjsvtinnsvgeftq.supabase.co
SUPABASE_ANON_KEY=

# Jina embeddings (Stage 1.4, primary embedding provider) — a real
# secret, server-only
JINA_API_KEY=

# Voyage embeddings (embedding fallback chain, 1st fallback after Jina)
# — a real secret, server-only
VOYAGE_API_KEY=

# Cohere rerank (Stage 1.5) + Cohere embeddings (embedding fallback
# chain, 2nd fallback after Voyage) — same key, both are Cohere's API —
# a real secret, server-only
COHERE_API_KEY=

# Gemini generation (Stage 1.7) — a real secret, server-only
GEMINI_API_KEY=

# Langfuse tracing (Stage 1.8) — real secrets, server-only. Fails open:
# with these unset, tracing spans become safe no-ops rather than errors
# (see app/core/tracing.py), so local dev/tests never need them.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
