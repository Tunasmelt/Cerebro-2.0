# Supabase project: "Cerebro" (vuwrefjsvtinnsvgeftq, ap-southeast-1)
# Real values go in .env / .env.local (git-ignored), never here.

# apps/web
NEXT_PUBLIC_SUPABASE_URL=https://vuwrefjsvtinnsvgeftq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only: apps/web's own API route handlers proxy to services/api
API_BASE_URL=https://cerebro-api-d47y.onrender.com

# services/api — uses the caller's own JWT for Storage/PostgREST calls
# (see Stage 1.1), not a service-role key, so RLS enforces ownership the
# same way it does for direct client access. anon key is not a secret
# (already public-safe, used client-side too) but still lives in env.
SUPABASE_URL=https://vuwrefjsvtinnsvgeftq.supabase.co
SUPABASE_ANON_KEY=

# Jina embeddings (Stage 1.4) — a real secret, server-only
JINA_API_KEY=
